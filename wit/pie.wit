package pie:core@0.1.0;

// Inferlets (WebAssembly modules) has the following runtime API:

interface model {

    /// Tokens per KV page.
    kv-page-size: func() -> u32;

    /// A sequence's KV cache: a list of pages the inferlet addresses as
    /// 0..page-len. Which physical pages back them is the runtime's business,
    /// so the inferlet never sees, and cannot misuse, a physical page id.
    /// Dropping the handle returns its pages to the shared pool.
    resource kv-working-set {
        constructor();
        page-len: func() -> u32;
        /// taken from the shared pool.
        reserve: func(n: u32) -> result<_, string>;
        /// A new working set sharing all of this one's pages. Nothing is
        /// copied: a shared page is copied only when one side writes to it.
        fork: func() -> kv-working-set;
    }

    tokenize: func(text: string) -> list<u32>;
    detokenize: func(tokens: list<u32>) -> string;
    eos-tokens: func() -> list<u32>;

    record distribution {
        ids: list<u32>,
        probs: list<f32>,
    }

    forward: func(
        kv: borrow<kv-working-set>,
        kv-len: u32,
        tokens: list<u32>,
        positions: list<u32>,
        top-k: u32,
    ) -> result<distribution, string>;
}

interface run {
    run: func(args: list<string>) -> result<string, string>;
}


world inferlet {
    import model;
    export run;
}
