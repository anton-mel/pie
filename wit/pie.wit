package pie:core@0.1.0;

// Inferlets (WebAssembly modules) has the following runtime API:

interface model {

    kv-page-size: func() -> u32;

    resource kv-working-set {
        constructor();
        page-len: func() -> u32;
        reserve: func(n: u32) -> result<_, string>;
        /// A new working set sharing all of this one's pages. Nothing is
        /// copied: a shared page is copied only when one side writes to it.
        fork: func() -> kv-working-set;
    }

    tokenize: func(text: string) -> list<u32>;
    detokenize: func(tokens: list<u32>) -> string;
    eos-tokens: func() -> list<u32>;

    record distribution {
        ids: list<u32>,
        probs: list<f32>,
    }

    /// A forward that has been submitted and not yet waited for.
    resource pending-forward {
        /// Block until the model has run it.
        wait: func() -> result<distribution, string>;
    }

    /// Submit a forward and return at once. Submitted forwards are handed to
    /// the engine together when the inferlet next waits, so an inferlet can
    /// submit one per sequence and have all of them run in the same step.
    forward: func(
        kv: borrow<kv-working-set>,
        kv-len: u32,
        tokens: list<u32>,
        positions: list<u32>,
        top-k: u32,
    ) -> result<pending-forward, string>;
}

interface run {
    run: func(args: list<string>) -> result<string, string>;
}


world inferlet {
    import model;
    export run;
}
