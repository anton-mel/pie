package pie:core@0.1.0;

// Inferlets (WebAssembly modules) has the following runtime API:

interface model {

    kv-page-size: func() -> u32;

    resource kv-working-set {
        constructor();
        page-len: func() -> u32;
        reserve: func(n: u32) -> result<_, string>;
        fork: func() -> kv-working-set;
        /// Drop `len` pages starting at page `start`, and free them. Later
        /// pages move down to fill the gap. The tokens in them are gone:
        /// later forwards do not attend to them.
        discard: func(start: u32, len: u32) -> result<_, string>;
        /// Publish this working set's pages under `key`, so that any
        /// inferlet can open them. Replaces what was published there.
        update-index: func(key: string);
        /// A working set sharing the pages published under `key`, as if it
        /// were forked from them. None if nothing is there: the index is a
        /// cache, and the runtime drops old entries when memory runs low.
        from-index: static func(key: string) -> option<kv-working-set>;
        /// Unpublish `key`. Working sets opened from it keep their pages.
        remove-index: static func(key: string) -> bool;
    }

    tokenize: func(text: string) -> list<u32>;
    detokenize: func(tokens: list<u32>) -> string;
    eos-tokens: func() -> list<u32>;

    record distribution {
        ids: list<u32>,
        probs: list<f32>,
    }

    resource pending-forward {
        /// One distribution per entry of `outputs`.
        wait: func() -> result<list<distribution>, string>;
    }

    /// Submit a forward and return at once.
    ///
    /// `outputs` picks which of `tokens` to return a next-token distribution
    /// for, by index: `[len - 1]` for plain decoding, every index to check a
    /// guess for each token at once, none for a prefill.
    ///
    /// `allowed`, if given, restricts every returned distribution to
    /// those token ids, renormalized. The inferlet decides what is allowed
    /// at each step, which is how it enforces a format or a grammar.
    forward: func(
        kv: borrow<kv-working-set>,
        kv-len: u32,
        tokens: list<u32>,
        positions: list<u32>,
        outputs: list<u32>,
        allowed: option<list<u32>>,
        top-k: u32,
    ) -> result<pending-forward, string>;
}

/// NEW
/// The model's chat format. Each role function returns the tokens that add
/// one message to a conversation; the inferlet appends them to a context.
interface chat {
    system: func(message: string) -> list<u32>;
    user: func(message: string) -> list<u32>;
    assistant: func(message: string) -> list<u32>;
    /// Start the assistant's turn: what the model generates next is its reply.
    cue: func() -> list<u32>;
    /// Close the assistant's turn after its reply has been generated.
    seal: func() -> list<u32>;
    /// Tokens the model ends its reply with.
    stop-tokens: func() -> list<u32>;
}

interface run {
    run: func(args: list<string>) -> result<string, string>;
}


world inferlet {
    import model;
    import chat;
    export run;
}
